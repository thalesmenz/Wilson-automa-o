{
  "name": "contabsquad-whatsapp-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm run server:dev\" \"npm run web:dev\"",
    "server:dev": "node --watch server/index.js",
    "web:dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
